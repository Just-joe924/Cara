# Server env (Express). Copy to server/.env and fill in.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase — server uses the SECRET service-role key to finalize orders
# (bypasses RLS). Keep this out of the browser and out of git.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT_URL.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Paystack — NGN payments (card, bank transfer, USSD).
# Dashboard -> Settings -> API Keys & Webhooks. Use the sk_test_... key until
# your business is approved, then swap in sk_live_...
# Leave blank to disable online payments (pay-on-pickup still works).
# Set the webhook URL there to: https://YOUR_API_HOST/api/webhooks/paystack
PAYSTACK_SECRET_KEY=

# Transactional email (Resend). Leave RESEND_API_KEY blank to disable email
# sending (the app still works — sends are skipped and logged). Get a key at
# https://resend.com. EMAIL_FROM must be a verified sender/domain; the shared
# onboarding@resend.dev test address works for early testing, but only delivers
# to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=Cara <onboarding@resend.dev>

# Inbox that contact-form messages are forwarded to. Replies go to the sender.
CONTACT_EMAIL_TO=

# Absolute URL of the logo shown in emails. Must be publicly reachable — a
# localhost URL renders as a broken image in real inboxes. Defaults to
# CLIENT_ORIGIN/img/logo.png.
LOGO_URL=

# Optional: default recipient for `npm run test:email` (else pass one as an arg).
TEST_EMAIL_TO=
